# WhatsApp Cloud API
VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_APP_SECRET=your_meta_app_secret
PHONE_NUMBER_ID=your_phone_number_id

# Agent / handler account
AGENT_PHONE=2547XXXXXXXX
HANDLER_PHONE=2547XXXXXXXX
HANDLER_PASSWORD=your_backend_password

# Backend
BACKEND_URL=https://your-backend-url.com

# M-Pesa Daraja
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-backend-url.com/mpesa/callback/
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Media
LOGO_MEDIA_ID=your_whatsapp_media_id

# LLM
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Sandbox: switch provider by setting TEST_PROVIDER (groq | gemini | deepseek | openai)
# Leave blank to use default Groq production chain
TEST_PROVIDER=
GROQ_TEST_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro
